# Single pin file for this image. Refresh with scripts/sync-release.sh.
# Dynamic tpc is linked against PHP_VERSION. --full-static links PHPX_SDK_*,
# which can be a different PHP patch release.
#
# Published image name without a tag. Leave unset for a local-only build.
# GitHub Actions sets IMAGE=ghcr.io/roiwk/typephp-docker. Example:
# IMAGE=ghcr.io/roiwk/typephp-docker

TYPEPHP_VERSION=v0.9.4
PHP_VERSION=8.4.26
PHP_SHA256=32a2de53862ad44ed4a5005244ce4f1b50c271e74dced215449a4443b40569f1

TPC_SHA256_X64=2fd0dc85f1b89b00b6003fa25755b19e3535802f9046e55fb4fca742ad080c8f
TPC_SHA256_ARM64=b4efc60e274eb277f30ef05ac1cacfb38b20c0272cf24c6d1d00d650eceb3423

# phpx/phpy commits that were current when the TypePHP release was published.
PHPX_REF=a0138bbdd6cbfda62225adc56c558d0742114c8a
PHPY_REF=5b9c650316ad87644e885a64a0a6767b03abdfa6

# Prebuilt full-static SDK from the PHPX release (libphp.a + libphpx.a).
PHPX_SDK_VERSION=v2.9.3
PHPX_SDK_PHP=8.4.25
PHPX_SDK_SHA256_X64=9fb69fe3e941edbae497d09bbcb09708b717320a7d5d81871ef28b56839f0285
PHPX_SDK_SHA256_ARM64=53b405a810c313e53bc1ff47b91bdc2afa5ae40ae0b971cc61b61da66769d579

# GitHub source archive for TYPEPHP_VERSION. tpc --wasm uses its wasm/*.sh.
TYPEPHP_SOURCE_SHA256=e085e197ce6505a15b310291f3f1347dfac11f60b977cfd7c56861e1879f2502

# Prebuilt wasm32-wasip2 PHP/PHPX. Not the host PHP 8.4.26.
PHPX_WASI_SDK_VERSION=v2.9.3
PHPX_WASI_SDK_PHP=8.5.9
PHPX_WASI_SDK_SHA256=31526c077fb512896546c85026eef01aa0aced36d651f64513f5235b6648249d

# Host clang that targets wasm32-unknown-wasip2. Tag is wasi-sdk-33.
# The PHPX wasm32-wasip2 package was built with this SDK. tpc rejects clang
# older than 22; this release is clang 22.
WASI_SDK_VERSION=33.0
WASI_SDK_SHA256_X64=0ba8b5bfaeb2adf3f29bab5841d76cf5318ab8e1642ea195f88baba1abd47bce
WASI_SDK_SHA256_ARM64=4f98ee738c7abb45c81a94d1461fc53cc569d1cd01498951c8184d841a027844

# wasmtime must be on PATH before tpc --wasm will start.
WASMTIME_VERSION=v49.0.2
WASMTIME_SHA256_X64=a4d6e9e3a5a60f527cf7793d674c48930c80c2e8977995b8a275cad3254b9322
WASMTIME_SHA256_ARM64=ca14988c6da3d92512bd9c3bad6cbd06b1f5743b6911a9e709f1a6fa30637d7f

# swoole/php-nano sources for tpc --nano. ABI must match the PHPX checkout above.
PHP_NANO_VERSION=v1.1.0
PHP_NANO_SHA256=f9d59c03b0cf6d1121ff3fe699fd00d7357b28df8f2ae9633a0448c7f1d2c064

# Android arm64-v8a. NDK r27d's Linux package is an x86_64 host toolchain.
# iOS and macOS need Xcode on a Mac; this image does not include them.
PHPX_ANDROID_SDK_SHA256=c7d142c151fd14fd8f652487f1404deffe94c08a9ab9cbb3e2bfd47f81b79f88
ANDROID_NDK_VERSION=r27d
ANDROID_NDK_SHA256=601246087a682d1944e1e16dd85bc6e49560fe8b6d61255be2829178c8ed15d9
ANDROID_CMDLINE_TOOLS_SHA256=7ec965280a073311c339e571cd5de778b9975026cfcbe79f2b1cdcb1e15317ee
