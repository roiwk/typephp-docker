# Single pin file for this image. Refresh with scripts/sync-release.sh.
# Dynamic tpc is linked against PHP_VERSION. --full-static links PHPX_SDK_*,
# which can be a different PHP patch release.
#
# Published image name without a tag. Leave unset for a local-only build.
# GitHub Actions sets IMAGE=ghcr.io/<owner>/<repo>. Example:
# IMAGE=ghcr.io/roiwk/typephp-docker

TYPEPHP_VERSION=v0.9.4
PHP_VERSION=8.4.26
PHP_SHA256=32a2de53862ad44ed4a5005244ce4f1b50c271e74dced215449a4443b40569f1

TPC_SHA256_X64=2fd0dc85f1b89b00b6003fa25755b19e3535802f9046e55fb4fca742ad080c8f
TPC_SHA256_ARM64=b4efc60e274eb277f30ef05ac1cacfb38b20c0272cf24c6d1d00d650eceb3423

# phpx/phpy commits that were current when the TypePHP release was published.
PHPX_REF=a0138bbdd6cbfda62225adc56c558d0742114c8a
PHPY_REF=5b9c650316ad87644e885a64a0a6767b03abdfa6

# Prebuilt full-static SDK from the PHPX release (libphp.a + libphpx.a).
PHPX_SDK_VERSION=v2.9.3
PHPX_SDK_PHP=8.4.25
PHPX_SDK_SHA256_X64=9fb69fe3e941edbae497d09bbcb09708b717320a7d5d81871ef28b56839f0285
PHPX_SDK_SHA256_ARM64=53b405a810c313e53bc1ff47b91bdc2afa5ae40ae0b971cc61b61da66769d579
